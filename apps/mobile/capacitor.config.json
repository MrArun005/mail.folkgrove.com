{
  "appId": "org.openmail.app",
  "appName": "OpenMail",
  "webDir": "../shell",
  "appendUserAgent": "OpenMailApp",
  "server": {
    "allowNavigation": [
      "*"
    ],
    "errorPath": "index.html"
  },
  "plugins": {
    "PushNotifications": {
