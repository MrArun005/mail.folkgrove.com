{
  "name": "openmail-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "OpenMail for macOS, Windows and Linux: a window onto your own OpenMail server",
  "main": "main.js",
  "scripts": {
    "start": "cp ../shell/index.html setup.html && electron .",
    "package": "cp ../shell/index.html setup.html && electron-packager . OpenMail --overwrite --out=dist --icon=icon.icns --ignore=^/dist --ignore=^/icon --protocol=mailto --protocol-name=Email --app-bundle-id=org.openmail.desktop"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3"
  }
}
