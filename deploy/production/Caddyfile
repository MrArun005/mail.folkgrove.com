# Caddy: HTTPS for the mail host, serves the web client and proxies everything else to Stalwart.
# Values come from .env (see docker-compose.yml).
{
	email {$ACME_EMAIL}
	# "acme" = Let's Encrypt in production; install.sh --local-test sets "internal" (Caddy's own CA).
	cert_issuer {$CADDY_CERT_ISSUER}
}

{$MAIL_HOSTNAME} {
	encode zstd gzip

	# The web client is a single page at "/" with hashed files under /assets/. "/admin" (exactly) is its admin
	# console; Stalwart's own admin stays at "/admin/" (with the slash).
	@app path / /admin
	handle @app {
		root * /srv
		rewrite * /index.html
		header Cache-Control "no-cache"
		file_server
	}
	# Installable-app files at the root of the build.
	@pwa path /sw.js /manifest.webmanifest /icon.svg /icons/* /legal/*
	handle @pwa {
		root * /srv
		header /sw.js Cache-Control "no-cache"
		file_server
	}
	# Confidential-message viewer: a static page; the key stays in the address after "#", which never reaches us.
	handle /confidential.html {
		root * /srv
		header {
			Cache-Control "no-cache"
			X-Robots-Tag "noindex, nofollow, noarchive"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
		file_server
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Public sign-up (signup/ service) for a hosted instance. Without that container this returns 502,
	# and the web client simply hides its "Create an account" link.
	# X-Real-IP is always overwritten with the real client address (clients can't spoof it), so per-IP rate
	# limits work. Run the signup container with CLIENT_IP_HEADER=x-real-ip.
	# /api/events is left out on purpose: only Stalwart posts to it, on the internal network.
	# /api/files and /f/*: large-file links (upload, and the public download page).
	@signup path /api/signup /api/username-available /api/aliases /api/aliases/* /api/session/* /api/account /api/admin/* /api/domains /api/domains/* /api/sending /api/sending/* /api/blocked /api/files /api/files/* /f/* /api/principal /.well-known/openpgpkey/* /api/retention /api/sso /api/sso/*
	handle @signup {
		reverse_proxy signup:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Everything else is Stalwart: /jmap, /.well-known/*, /admin, /api, /auth, /dav, autoconfig, ...
	handle {
		reverse_proxy stalwart:8080
	}
}

# Web Key Directory (advanced method): other mail apps find our users' OpenPGP keys here. DNS: CNAME openpgpkey → mail host.
openpgpkey.{$MAIL_DOMAIN} {
	handle /.well-known/openpgpkey/* {
		reverse_proxy signup:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
	respond 404
}

# Discovery hosts from Stalwart's suggested DNS zone (all CNAMEs to the mail host).
# Caddy keeps retrying certificates for names whose DNS isn't set up yet; that's harmless.
mta-sts.{$MAIL_DOMAIN}, autoconfig.{$MAIL_DOMAIN}, autodiscover.{$MAIL_DOMAIN}, ua-auto-config.{$MAIL_DOMAIN} {
	reverse_proxy stalwart:8080
}

# --webmail-host: an easier webmail address that redirects here (install.sh writes this file; empty without it).
import webmail.caddy
